# Production Environment Variables for Netlify Deployment
# Replace these values with your actual production URLs and keys

# Backend API URL (Render deployment)
VITE_API_URL=https://smart-car-parking-wa4f.onrender.com

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Razorpay Key (for payment integration)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here

# Google Maps API Key (if using maps)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
